# BWARM Dashboard - Environment Configuration
# Copy this file to .env and update with your values

# ============================================================
# Project Configuration
# ============================================================
PROJECT_NAME=bwarm_dashboard

# ============================================================
# Database Configuration
# ============================================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bwarm_dev

# ============================================================
# API Configuration
# ============================================================
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
DEBUG=true

# ============================================================
# Security & JWT
# ============================================================
# CRITICAL: SECRET_KEY must be changed in production!
# Generate a secure 32-byte hex key with: openssl rand -hex 32
# The application will refuse to start in production with the default value.
# Set DEBUG=false for production to enable validation.
SECRET_KEY=change-this-secret-key-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting (requests per time period)
# Format: "number/period" (e.g., "100/minute", "1000/hour")
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_ATTEMPTS=5

# ============================================================
# CORS Configuration
# ============================================================
FRONTEND_URL=http://localhost:5173
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================
# Redis Configuration
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============================================================
# Celery Configuration
# ============================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============================================================
# Elasticsearch Configuration
# ============================================================
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_INDEX_PREFIX=bwarm_

# ============================================================
# File Upload Configuration
# ============================================================
# Maximum upload size in megabytes
MAX_UPLOAD_SIZE_MB=500
# Comma-separated list of allowed extensions
ALLOWED_FILE_EXTENSIONS=csv,xlsx,xls,json,xml

# ============================================================
# Catalog Matching Configuration
# ============================================================
# Minimum confidence threshold (0.0-1.0)
MATCH_CONFIDENCE_THRESHOLD=0.6
# Maximum number of matches to return per track
MAX_MATCHES_PER_TRACK=10

# ============================================================
# Logging Configuration
# ============================================================
LOG_LEVEL=INFO
